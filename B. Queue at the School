#include<bits/stdc++.h>
using namespace std;
int main()
{
    int n,a;
    cin>>n>>a;
    string s;
    cin>>s;

    for(int i=0;i<a;i++)
    {
        for(int j=0;j<s.size()-1;j++)
        {
            if(s[j]=='B' && s[j+1]=='G')
            {
                s[j]='G';
                s[j+1]='B';
                j++;
            }
        }
    }
    cout<<s<<endl;

}
