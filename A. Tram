#include<bits/stdc++.h>
using namespace std;
int main()
{
    int n,s=0,x,y,p=0,q=0,a=-6000000;
    cin>>n;
    while(n--)
    {
        cin>>x>>y;

        if(n>0)
         {
           p=((s-x)+y);
           s=p;
           a=max(a,p);
         }
         else
         {
           q=abs(x-y);
           s=q;
           a=max(a,q);
         }
        p=0;

    }
    cout<<a;
}
