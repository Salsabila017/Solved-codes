// Online C++ compiler to run C++ program online
#include <bits/stdc++.h>
using namespace std;

int main() {
    int t, a,b,c;
    cin>>t;
    while(t--)
    {
        cin>>a>>b>>c;
        if (a>b && a>c)
        {
         if(b>c)
         {
             cout<<b<<endl;
         }
         else if (b<c)
         {
             cout<<c<<endl;
         }
        }
        
        else if(b>a && b>c)
        {
         if(a>c)
         {
             cout<<a<<endl;
         }
         else if (a<c)
         {
             cout<<c<<endl;
         }
        }
        else if (c>a && c>b)
        {
         if(a>b)
         {
             cout<<a<<endl;
         }
         else if (a<b)
         {
             cout<<b<<endl;
         }
        }
    }

    return 0;
}
