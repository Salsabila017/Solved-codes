#include <bits/stdc++.h>
using namespace std;

int main() {
    int n;
    cin >> n;
    int arr[100], even = 0, odd = 0;
    int evenIndex = 0, oddIndex = 0;

    for (int i = 0; i < n; i++) {
        cin >> arr[i];
        if (arr[i] % 2 == 0) {
            even++;
            evenIndex = i + 1; 
        } else {
            odd++;
            oddIndex = i + 1;
        }
    }

    
    if (even > odd) {
        cout << oddIndex << endl;
    } else {
        cout << evenIndex << endl;
    }

    return 0;
}
