#include<bits/stdc++.h>
using namespace std;
int main()
{
    int n,s,p=0,q=0,a[1000];
    cin>>n>>s;
    for(int i=0;i<n;i++)
    {
        cin>>a[i];
        if(a[i]>s)
        {
            p=2;
            q=p+q;
        }
        else
        {
            p=1;
            q=p+q;
        }
    }
    cout<<q;

}
