#include <bits/stdc++.h>
using namespace std;

int main() {
	int t,a,b,c;
	cin>>t;
	while(t--)
	{
	    cin>>a>>b>>c;
	    if((a^b)!=0 && (b^c)==0 && (c^a)!=0)
	    {
	        cout<<a<<endl;
	    }
	    else if((a^b)!=0 && (b^c)!=0 && (c^a)==0)
	    {
	        cout<<b<<endl;
	    }
	    else if((a^b)==0 && (b^c)!=0 && (c^a)!=0)
	    {
	        cout<<c<<endl;
	    }
	}

}
